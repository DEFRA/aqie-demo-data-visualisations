# Backend service URL configuration
# When running demo locally and connecting to CDP backend, use the ephemeral gateway:
#   AQIE_BACK_END_URL=https://ephemeral-protected.api.dev.cdp-int.defra.cloud/aqie-back-end
# For local Docker development (demo and backend on same network):
#   AQIE_BACK_END_URL=http://aqie-back-end:3001
# For local development (all services on localhost):
#   AQIE_BACK_END_URL=http://localhost:3001
AQIE_BACK_END_URL=https://ephemeral-protected.api.dev.cdp-int.defra.cloud/aqie-back-end

# CDP API key for ephemeral gateway access (external local-to-CDP connections)
# Expiry: 24 hours on dev/test/perf-test, 2 hours on prod
# Only needed when connecting locally to CDP backend via ephemeral gateway
# Not needed for internal CDP-to-CDP service-to-service calls
CDP_X_API_KEY=<your-api-key-here>

